---
/**
 * Home page (/) — the site root.
 *
 * Composes, inside the shared site Layout (persistent nav + footer, global
 * theme, structured data), the home page content in order:
 *
 *   1. HeroSection — the hero Carousel with the Capability_Statement and the
 *      outcome-focused Mission_Statement directly beneath it (Req 1.3, 1.6).
 *   2. ProductCatalog — a preview of the productized offerings under their own
 *      "Products" label, with a "See all products" link to /products (Req 2.2).
 *   3. ServiceHighlights — a preview of the services, with a "See all services"
 *      link to /services (Req 9.5).
 *   4. CaseStudyCollection — a preview of the client engagements as case studies
 *      (date-free ordering, each linking to `/work/{slug}`), with a "See all
 *      case studies" link to /work (Req 4.1, 4.3, 4.6, 9.6).
 *
 * Hybrid layout: Products, Services, and Case Studies are each a self-contained
 * top-level section — heading + a few example bubbles + a "See all →" link to
 * the section's full detail page.
 *
 * Content is imported from the validated seed JSON (the build-time smoke check
 * validates it) and passed to the components as props. The slide deck's
 * `slides`/`intervalSeconds` feed the hero carousel; `mission.json` feeds both
 * the Mission_Statement and, via `mission.capability`, the Capability_Statement.
 *
 * WIRING NOTES (task 15.1)
 * ------------------------
 * - The Capability_Statement is passed to HeroSection as `capability`, sourced
 *   from `mission.capability` (optional). HeroSection renders placeholder text
 *   and preserves reserved above-the-fold space when it is absent (Req 1.6, 1.8).
 * - The old blog-style ProjectShowcase / `projects.json` / `Project` wiring is
 *   fully removed. The home page now composes CaseStudyCollection from the
 *   `caseStudies.json` document (Req 4.1). CaseStudyCollection renders its own
 *   "Our Work" heading and the Case Studies CTA/Contact_Path, mirroring the
 *   HeroSection home-section CTA (Case Studies → /work, per Req 9.6).
 *
 * This page passes `isRoot` so the Layout additionally emits the site-level
 * WebSite JSON-LD, and identifies itself as the IA `home` page so the nav shows
 * the correct current-section indicator.
 *
 * Requirements: 1.3, 1.6, 9.5, 9.6 (home assembly + section CTAs); no
 * search/login/registration controls are rendered here.
 */
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import ProductCatalog from "../components/ProductCatalog.astro";
import ServiceHighlights from "../components/ServiceHighlights.astro";
import CaseStudyCollection from "../components/CaseStudyCollection.astro";
import type {
  CaseStudy,
  Mission,
  Product,
  ServicesPage,
  SlideDeck,
} from "../types";
import slidesData from "../content/slides.json";
import missionData from "../content/mission.json";
import productsData from "../content/products.json";
import caseStudiesData from "../content/caseStudies.json";
import servicesData from "../content/services.json";

// Seed content is Schema.org-aligned and validated by the build-time smoke
// check, so direct imports are safe here.
const slideDeck = slidesData as SlideDeck;
const mission = missionData as Mission;
const products = productsData as Product[];
const caseStudies = caseStudiesData as CaseStudy[];
const services = (servicesData as ServicesPage).offerings;

// Home-page preview cap: each top-level section shows a few example bubbles and
// links to its full detail page ("hybrid" layout — Products, Services, and Case
// Studies each a self-contained top-level section).
const HOME_PREVIEW_LIMIT = 3;
---

<Layout title="Cadocary" current="home" isRoot>
  {/* Hero at the top of the home page (Req 1.3): carousel + Capability_Statement
      + Mission_Statement + section CTAs beneath. The Capability_Statement is the
      optional `mission.capability` block; HeroSection degrades gracefully when it
      is absent (Req 1.6, 1.8). */}
  <HeroSection
    slides={slideDeck.slides}
    intervalSeconds={slideDeck.intervalSeconds}
    mission={mission}
    capability={mission.capability ?? null}
  />

  {/* Hybrid layout: Products, Services, and Case Studies are each a top-level
      home section with its own heading, a few example bubbles, and a "See all →"
      link to the full detail page. */}

  <section class="home-section" aria-label="Products">
    {/* ProductCatalog renders its own visible "Products" heading (Req 2.2). On
        the home page it shows a capped preview + a "See all products" link to
        the full catalog at /products (Req 9.5-style section navigation). */}
    <ProductCatalog
      products={products}
      limit={HOME_PREVIEW_LIMIT}
      seeAllHref="/products"
      seeAllLabel="See all products"
    />
  </section>

  <section class="home-section" aria-label="Services">
    {/* ServiceHighlights previews a few service offerings and links to the full
        Services page at /services. */}
    <ServiceHighlights
      offerings={services}
      caseStudies={caseStudies}
      limit={HOME_PREVIEW_LIMIT}
      seeAllHref="/services"
      seeAllLabel="See all services"
    />
  </section>

  <section class="home-section" aria-label="Case studies">
    {/* CaseStudyCollection renders its own "Our Work" heading, date-free ordered
        cards each linking to `/work/{slug}` (Req 4.1, 4.3, 4.6). On the home page
        it shows a capped preview + a "See all case studies" link to /work; the
        Contact_Path is shown on the Work index page, not this preview. */}
    <CaseStudyCollection
      caseStudies={caseStudies}
      limit={HOME_PREVIEW_LIMIT}
      seeAllHref="/work"
      seeAllLabel="See all case studies"
      showContact={false}
    />
  </section>
</Layout>

<style>
  .home-section {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg, 2rem) var(--space-md, 1rem);
  }
</style>
