---
/**
 * /blog/{slug} — a migrated blog post, rendered as a static, pre-rendered route.
 *
 * `getStaticPaths` enumerates one page per migrated post (from
 * src/content/blog.ts). Each post's blocks are rendered to semantic HTML,
 * preserving the xkcd image references (as linked figures) and external links.
 */
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { blogPosts, type BlogPost } from "../../content/blog";

export const getStaticPaths = (() => {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<Layout title={post.title}>
  <article class="post">
    <h1>{post.title}</h1>
    {
      post.blocks.map((block) => {
        if (block.type === "heading") {
          return block.level === 2 ? <h2>{block.text}</h2> : <h3>{block.text}</h3>;
        }
        if (block.type === "paragraph") {
          return <p>{block.text}</p>;
        }
        if (block.type === "figure") {
          return (
            <figure class="post-figure">
              {/* Preserve the original xkcd reference as a link. */}
              <a href={block.href} rel="noopener noreferrer">
                {block.alt}
              </a>
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          );
        }
        if (block.type === "link") {
          return (
            <p>
              <a href={block.href} rel="noopener noreferrer">
                {block.label}
              </a>
            </p>
          );
        }
        return null;
      })
    }
    <p><a href="/blog">Back to all posts</a></p>
  </article>
</Layout>

<style>
  .post {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-lg, 2rem) var(--space-md, 1rem);
  }

  .post-figure {
    margin: 0 0 var(--space-md, 1rem);
    padding: var(--space-sm, 0.5rem) 0;
  }

  .post-figure figcaption {
    font-size: var(--font-size-small, 0.875rem);
    color: var(--color-muted, #717171);
  }
</style>
