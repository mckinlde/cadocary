---
/**
 * HeroSection — composes the hero Carousel island with the static
 * Capability_Statement and Mission_Statement directly beneath it, plus the
 * home-page top-level section CTAs.
 *
 * ## Layout contract (why this component exists)
 *
 * The Hero_Section is the primary visual area at the top of the home page. It
 * is deliberately split into stacked, independent regions:
 *
 *   1. the interactive <Carousel/> island (the ONLY hydrated part),
 *   2. the static Capability_Statement rendered as plain server HTML, and
 *   3. the static Mission_Statement rendered as plain server HTML.
 *
 * Keeping the Capability_Statement and Mission as separate static markup — not
 * inside the carousel and not driven by any client state — is what guarantees
 * the positioning copy is fully rendered and visible on load WITHOUT any
 * interaction (Req 1.1, 2.1) and cannot change as slides advance (it shares no
 * state with the carousel island). The carousel can auto-advance, pause, and
 * rebuild its slide sequence all it likes; the copy below is untouched.
 *
 * ## Capability_Statement (Req 1.1, 2.1)
 *
 * The Capability_Statement is above-the-fold server HTML that identifies
 * Cadocary as a builder of custom software for organizations and names concrete
 * capabilities (web platforms, native mobile, data pipelines, AI/ML, automation
 * — supplied by the authored `mission.capability` content). It is visible
 * without interaction.
 *
 * ## Graceful degradation (Req 1.8, 2.6)
 *
 * If the Capability_Statement (or Mission) copy is unavailable — missing object,
 * or empty/absent body blocks — the region still renders placeholder text
 * ("temporarily unavailable") and keeps the SAME reserved above-the-fold layout
 * space (a `min-height`) so the page does not shift. The reserved space applies
 * whether real copy or the placeholder is shown.
 *
 * ## Home-page section navigation
 *
 * The distinct, labeled links to each top-level section (Products, Services,
 * Case Studies) live in those sections themselves on the home page — each
 * section renders its own heading, example bubbles, and a "See all →" link to
 * its detail page (see index.astro). The hero therefore focuses on the carousel
 * plus the Capability_Statement and Mission copy.
 *
 * The component accepts its content as props so the home-page wiring (task 15.1)
 * can pass already-validated content in; it does not load JSON itself.
 */
import Carousel from "./Carousel.astro";
import ContentBody from "./ContentBody.astro";
import type { CapabilityStatement, Mission, Slide } from "../types";

interface Props {
  /** Authored slides in order (validated length 2..10). */
  slides: Slide[];
  /** Auto-advance interval in seconds (validated 5..8 inclusive). */
  intervalSeconds: number;
  /**
   * The mission copy. Optional/nullable so the caller can pass `undefined`/null
   * when the mission document failed to load — this component renders the
   * placeholder fallback in that case (Req 1.8, 2.6).
   */
  mission?: Mission | null;
  /**
   * The Capability_Statement copy. Optional/nullable so the caller (task 15.1)
   * can pass `mission.capability` in. When absent/unavailable this component
   * renders placeholder text while preserving the reserved above-the-fold space
   * (Req 1.8, 2.6).
   */
  capability?: CapabilityStatement | null;
}

const { slides, intervalSeconds, mission, capability } = Astro.props;

// The Capability_Statement is considered "unavailable" when there is no object
// or its body has no content blocks. In that case we render placeholder text
// while preserving the reserved above-the-fold space (Req 1.8, 2.6).
const hasCapability =
  !!capability && Array.isArray(capability.body) && capability.body.length > 0;
const capabilityHeading = hasCapability ? capability!.heading : "What Cadocary builds";

// The mission is considered "unavailable" when there is no mission object or its
// body has no content blocks. In that case we render placeholder text while
// preserving the reserved layout space (Req 1.8, 2.6).
const hasMission = !!mission && Array.isArray(mission.body) && mission.body.length > 0;
const missionHeading = hasMission ? mission!.heading : "Our mission";
---

<section class="hero" aria-label="Highlights, capabilities, and mission">
  {/* Region 1: the interactive carousel island (hydrated). */}
  <Carousel slides={slides} intervalSeconds={intervalSeconds} />

  {/*
    Region 2: the Capability_Statement. Static, above-the-fold server HTML that
    is present in the DOM and visible without interaction (Req 1.1, 2.1). It
    identifies Cadocary as a builder of custom software for organizations and
    names concrete capabilities via the authored content. Shares no state with
    the carousel, so it never changes as slides advance. Graceful degradation
    and reserved space are enforced in CSS below (Req 1.8, 2.6).
  */}
  <section class="hero__capability" aria-label="What Cadocary builds">
    <div class="hero__capability-inner">
      <h2 class="hero__capability-heading">{capabilityHeading}</h2>
      {
        hasCapability ? (
          <div class="hero__capability-body">
            <ContentBody blocks={capability!.body} />
          </div>
        ) : (
          // Req 1.8 / 2.6: placeholder text; the reserved above-the-fold space is
          // preserved by the .hero__capability min-height regardless of branch.
          <p class="hero__capability-placeholder">
            Capability information is temporarily unavailable.
          </p>
        )
      }
    </div>
  </section>

  {/*
    Region 3: the Mission_Statement. Static server HTML rendered directly beneath
    the capability statement. Always present in the DOM and visible without
    interaction (Req 1.2), and shares no state with the carousel so it never
    changes as slides advance. Graceful degradation + reserved space in CSS.
  */}
  <section class="hero__mission" aria-label="Mission statement">
    <div class="hero__mission-inner">
      <h2 class="hero__mission-heading">{missionHeading}</h2>
      {
        hasMission ? (
          <div class="hero__mission-body">
            <ContentBody blocks={mission!.body} />
          </div>
        ) : (
          // Req 1.8 / 2.6: placeholder text; the reserved space is preserved by
          // the .hero__mission min-height regardless of which branch renders.
          <p class="hero__mission-placeholder">
            Mission content is temporarily unavailable.
          </p>
        )
      }
    </div>
  </section>

</section>

<style>
  .hero {
    display: block;
    width: 100%;
  }

  /*
    Req 1.1 / 2.1: the Capability_Statement sits directly beneath the carousel as
    above-the-fold content. Req 1.8 / 2.6: reserve layout space so the page does
    not shift whether the real copy or the placeholder is shown. This min-height
    applies to both branches.

    Presentation: the copy is wrapped in a constrained, centered container (the
    same readable column width the rest of the home page uses) with a light card
    surface, so it doesn't read as bare full-width, left-aligned text.
  */
  .hero__capability {
    max-width: 72rem;
    margin-block-start: var(--space-lg, 2rem);
    margin-inline: auto;
    padding: var(--space-lg, 2rem) var(--space-md, 1.25rem);
    min-height: 8rem;
  }

  .hero__capability-inner,
  .hero__mission-inner {
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--space-lg, 2rem);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 1rem);
    background: var(--color-surface, #ffffff);
    box-shadow: var(--shadow-card, 0 22px 60px rgba(15, 23, 42, 0.06));
  }

  .hero__capability-heading {
    font-size: var(--font-size-h2, 1.5rem);
    color: var(--color-heading, #111827);
    margin: 0 0 var(--space-sm, 0.5rem);
  }

  .hero__capability-body,
  .hero__capability-placeholder {
    margin: 0;
    color: var(--color-text, #444444);
  }

  .hero__capability-placeholder,
  .hero__mission-placeholder {
    color: var(--color-muted, #717171);
  }

  /*
    Req 1.2: the mission sits beneath the capability statement. Req 1.8 / 2.6:
    reserve layout space so the page does not shift whether the real mission copy
    or the placeholder is shown.
  */
  .hero__mission {
    max-width: 72rem;
    margin-block-start: var(--space-lg, 2rem);
    margin-inline: auto;
    padding: 0 var(--space-md, 1.25rem);
    min-height: 8rem;
  }

  .hero__mission-heading {
    font-size: var(--font-size-h2, 1.5rem);
    color: var(--color-heading, #111827);
    margin: 0 0 var(--space-sm, 0.5rem);
  }

  .hero__mission-body,
  .hero__mission-placeholder {
    margin: 0;
    color: var(--color-text, #444444);
  }
</style>
