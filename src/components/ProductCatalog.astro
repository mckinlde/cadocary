---
/**
 * ProductCatalog — presents all Products in a stable, defined order under a
 * visible, productized-offerings label that is distinct from the Case Studies
 * (custom client engagement) label.
 *
 * This is a static-rendered presentation component (no client JS): it takes the
 * authored products, orders them with the pure `orderProducts` domain function
 * (ascending `order`, then `id`), and renders one card per product. Each card
 * shows the Schema.org-aligned `name` and `description`, the product's own
 * explicitly-associated image (or a collapsed image space when absent), and a
 * call-to-action link.
 *
 * Requirements:
 *   - 2.2  Products are presented under a VISIBLE "Products" / productized-
 *          offerings label/heading that is distinct from the Case Studies
 *          label (products are Cadocary's own productized offerings; case
 *          studies are the custom client engagements).
 *   - 2.3  Products and case studies are distinct collections.
 *   - 2.5  Each card keeps name (<= 120) + description (<= 300) + a CTA.
 *   - 6.2  Each product renders its own explicitly-associated image with
 *          descriptive alt text naming the product.
 *   - 6.5  When a product has no image, the image space collapses gracefully
 *          (no broken <img>) via `resolveImage`.
 *   - 8.6  Every card exposes a heading, summary, and call-to-action.
 *
 * Image handling: `product.image` is a STRING path in the Product type/schema
 * (the single source of the product picture). We adapt it into the shape
 * `resolveImage` expects (`{ image?: { src, alt } }`), deriving descriptive alt
 * text that names the product (Req 6.2). `resolveImage` returns
 * `{ kind: "none" }` for an absent/empty path, letting us collapse the image
 * space rather than emit a broken reference (Req 6.5).
 *
 * A product may be "external": if its `url` points outside `/products/` (e.g.
 * the Highlighter app carried over at `/highlighter/`), the card links directly
 * to that URL with a "Try it live" call-to-action instead of a generated detail
 * page. Otherwise the card links to the product's detail page at
 * `/products/{slug}`.
 */
import { orderProducts } from "../domain/ordering";
import { resolveImage } from "../domain/images";
import type { Product } from "../types";

interface Props {
  products: Product[];
  /**
   * When set, render at most this many example cards (a home-page PREVIEW).
   * The full list is shown on the section's own index page. Omitted -> show all.
   */
  limit?: number;
  /** When set, render a "see all" link to the section's detail/index page. */
  seeAllHref?: string;
  /** Visible label for the see-all link (defaults to "See all products"). */
  seeAllLabel?: string;
}

const {
  products,
  limit,
  seeAllHref,
  seeAllLabel = "See all products",
} = Astro.props;

// Stable, deterministic order (Req 5.1 / Property 10). orderProducts returns a
// new array, so the caller's data is never mutated.
const orderedAll = orderProducts(products);
// On the home page we show a capped PREVIEW; the full catalog lives at the
// section's index page (linked via `seeAllHref`). Without a limit, show all.
const ordered =
  typeof limit === "number" ? orderedAll.slice(0, limit) : orderedAll;

/**
 * A product is "external" when it carries a `url` that is not its own generated
 * detail path (i.e. it does not begin with `/products/`). Such a product links
 * out to that URL ("Try it live") rather than to a generated detail page.
 */
function isExternal(product: Product): boolean {
  return typeof product.url === "string" && !product.url.startsWith("/products/");
}

/**
 * Resolve a product's image through the pure `resolveImage` helper (Req 6.2,
 * 6.5). `product.image` is a plain string path, so we adapt it into the
 * `{ image: { src, alt } }` shape the helper expects and derive descriptive alt
 * text that names the product. An absent/empty path resolves to
 * `{ kind: "none" }`, so the card collapses the image space instead of
 * rendering a broken <img>.
 */
function resolveProductImage(product: Product) {
  const src = typeof product.image === "string" ? product.image : undefined;
  return resolveImage({
    image: src ? { src, alt: `${product.name} product screenshot` } : undefined,
  });
}
---

<section class="product-catalog" aria-labelledby="products-heading">
  {/* Req 2.2: a visible Products label + intro clarifying these are Cadocary's
      own productized offerings, distinct from the custom client engagements
      shown as case studies. */}
  <header class="product-catalog__intro">
    <h2 id="products-heading" class="product-catalog__heading">Products</h2>
    <p class="product-catalog__lede">
      Cadocary&rsquo;s own productized offerings &mdash; ready-to-use software you can
      try today.
    </p>
  </header>
  {
    ordered.length === 0 ? (
      // Req 5.6: explicit empty-state message when there are no products.
      <p class="empty-state">No products are currently available.</p>
    ) : (
      <ul class="catalog-grid" role="list">
        {ordered.map((product) => {
          const image = resolveProductImage(product);
          const href = isExternal(product) ? product.url : `/products/${product.slug}`;
          const cta = isExternal(product) ? "Try it live →" : "Learn more →";
          return (
            <li class="catalog-card">
              {/* Req 2.5 / 8.6: heading + summary + CTA. External products link
                  straight to the live app; the rest link to /products/{slug}. */}
              <a class="catalog-card__link" href={href}>
                {image.kind === "image" ? (
                  // Req 6.2: product's own image with descriptive, product-naming alt.
                  <img
                    class="catalog-card__image"
                    src={image.src}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ) : null /* Req 6.5: no image -> collapse the space (no broken <img>). */}
                <h3 class="catalog-card__name">{product.name}</h3>
                <p class="catalog-card__description">{product.description}</p>
                <span class="catalog-card__cta">{cta}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }

  {/* "See all" link to the full section index (home-page preview only). */}
  {
    seeAllHref && (
      <p class="catalog-see-all">
        <a class="catalog-see-all__link" href={seeAllHref}>
          {seeAllLabel} &rarr;
        </a>
      </p>
    )
  }
</section>

<style>
  .product-catalog__intro {
    margin-bottom: var(--space-lg, 2rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm, 0.5rem);
  }

  .product-catalog__heading {
    font-size: var(--font-size-h2, 1.75rem);
    margin: 0;
    color: var(--color-heading, #0f172a);
  }

  .product-catalog__lede {
    font-size: var(--font-size-body, 1rem);
    color: var(--color-muted, #717171);
    margin: 0;
    max-width: 60ch;
  }

  .catalog-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg, 2rem);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }

  .catalog-card {
    border: 1px solid var(--color-border, #d7d7d7);
    border-radius: var(--radius-md, 1rem);
    background: var(--color-surface, #ffffff);
    box-shadow: var(--shadow-card, 0 22px 60px rgba(15, 23, 42, 0.08));
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .catalog-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 26px 68px rgba(15, 23, 42, 0.12);
  }

  .catalog-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm, 0.5rem);
    padding: var(--space-md, 1.25rem);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .catalog-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--color-surface-muted, #f1f5f9);
  }

  .catalog-card__name {
    font-size: var(--font-size-h3, 1.125rem);
    margin: 0;
  }

  .catalog-card__description {
    font-size: var(--font-size-body, 1rem);
    color: var(--color-muted, #717171);
    margin: 0;
    flex: 1 1 auto;
  }

  .catalog-card__cta {
    align-self: flex-start;
    color: var(--color-link, #0074d4);
    font-weight: 600;
  }

  .catalog-card__link:focus-visible {
    outline: 2px solid var(--color-focus, #0074d4);
    outline-offset: 2px;
  }

  .empty-state {
    font-size: var(--font-size-body, 1rem);
    color: var(--color-muted, #717171);
  }

  .catalog-see-all {
    margin: var(--space-lg, 2rem) 0 0;
  }

  .catalog-see-all__link {
    color: var(--color-link, #0074d4);
    font-weight: 600;
    text-decoration: none;
  }

  .catalog-see-all__link:hover,
  .catalog-see-all__link:focus-visible {
    text-decoration: underline;
  }
</style>
