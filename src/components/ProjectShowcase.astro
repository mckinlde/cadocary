---
/**
 * ProjectShowcase.astro — the Project_Showcase presentation component (task 13.2).
 *
 * WHAT IT RENDERS
 * ---------------
 * A list of project cards ordered most-recently-added first, using the pure
 * `orderProjects` domain function (by `dateCreated` descending, tie-broken by
 * `id`; see `src/domain/ordering.ts`). Each card shows the project's `name`,
 * `description`, and a link to its detail page (`/projects/{slug}`). When there
 * are no projects, an explicit empty-state message is rendered instead of an
 * empty region (Requirement 6.6).
 *
 * WHY STATIC-RENDERED (no client JS)
 * ----------------------------------
 * The showcase is a non-interactive list of links, so it is rendered on the
 * server at build time as ordinary semantic HTML and ships zero client-side
 * JavaScript (design.md → static-first with selective hydration; only the hero
 * carousel is a hydrated island).
 *
 * DATA FLOW
 * ---------
 * Projects are accepted as a prop so this component can be composed both on the
 * projects index page and the home page without re-reading content. The caller
 * passes the validated `Project[]`; ordering happens here via `orderProjects`.
 *
 * Requirements: 6.1 (most-recently-added first), 6.2 (name, description, detail
 * link), 6.3 (link navigates to detail page), 6.6 (empty-state message), 2.4
 * (projects presented within the Projects section).
 */
import type { Project } from "../types";
import { orderProjects } from "../domain/ordering";

interface Props {
  /** The validated projects to present. Ordering is applied here. */
  projects: readonly Project[];
}

const { projects } = Astro.props;

// Order most-recently-added first (design Property 11 / Requirement 6.1). The
// domain function returns a new array and never mutates the input.
const ordered = orderProjects(projects);
---

<section class="project-showcase" aria-label="Project showcase">
  {
    ordered.length === 0 ? (
      // Empty-state message rather than an empty region (Requirement 6.6).
      <p class="project-showcase__empty">No projects are currently available.</p>
    ) : (
      <ul class="project-showcase__list" role="list">
        {ordered.map((project) => (
          <li class="project-card">
            <h3 class="project-card__name">{project.name}</h3>
            <p class="project-card__description">{project.description}</p>
            {/* Real anchor to the detail page `/projects/{slug}` (Req 6.2, 6.3). */}
            <a class="project-card__link" href={`/projects/${project.slug}`}>
              View project
              <span class="visually-hidden">: {project.name}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .project-showcase__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg, 2rem);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }

  .project-card {
    border: 1px solid var(--color-border, #e0e0e0);
    border-radius: var(--radius-md, 0.5rem);
    padding: var(--space-md, 1rem);
    background: var(--color-surface, #f7f7f7);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm, 0.5rem);
  }

  .project-card__name {
    font-size: var(--font-size-h3, 1.125rem);
    margin: 0;
  }

  .project-card__description {
    font-size: var(--font-size-body, 1rem);
    margin: 0;
    flex: 1 1 auto;
  }

  .project-card__link {
    align-self: flex-start;
    color: var(--color-link, #1a4fd6);
    text-decoration: none;
    font-weight: 600;
  }

  .project-card__link:hover,
  .project-card__link:focus-visible {
    text-decoration: underline;
  }

  /* Visible focus indicator for keyboard operation (accessibility). */
  .project-card__link:focus-visible {
    outline: 2px solid var(--color-focus, #1a4fd6);
    outline-offset: 2px;
  }

  .project-showcase__empty {
    font-size: var(--font-size-body, 1rem);
    color: var(--color-muted, #555);
  }

  /* Screen-reader-only text so the link name is descriptive without visual noise. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
